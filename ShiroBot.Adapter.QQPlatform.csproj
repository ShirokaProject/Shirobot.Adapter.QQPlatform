<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>ShiroBot.Adapter.QQPlatform</AssemblyName>
    <RootNamespace>ShiroBot.Adapter.QQPlatform</RootNamespace>
    <ShiroBotPluginPackagingEnabled>true</ShiroBotPluginPackagingEnabled>
    <ShiroBotPluginSharedAssemblies>ShiroBot.QQPlatform.Contracts;ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
  </PropertyGroup>
  <Import Project="$(ShiroBotSourceRoot)/SDK/buildTransitive/ShiroBot.SDK.props" />
  <ItemGroup>
    <Compile Remove="Contracts/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="samples/**/*.cs" />
    <ProjectReference Include="Contracts/ShiroBot.QQPlatform.Contracts.csproj" />
    <ProjectReference Include="$(ShiroBotSourceRoot)/SDK/ShiroBot.SDK.csproj" Private="false" />
    <ProjectReference Include="$(ShiroBotSourceRoot)/Models/QQ/ShiroBot.Model.QQ.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ShiroBot.QQPlatform.Tests" />
  </ItemGroup>
  <Target Name="RestoreQQPlatformContractToOutput" AfterTargets="RemoveShiroBotPluginDependencyFile"
          Condition="'$(ShiroBotPluginPackagingEnabled)' == 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Contracts/bin/$(Configuration)/$(TargetFramework)/ShiroBot.QQPlatform.Contracts.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="RestoreQQPlatformContractToPublish" AfterTargets="RemovePublishedShiroBotPluginDependencyFile"
          Condition="'$(ShiroBotPluginPackagingEnabled)' == 'true'">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Contracts/bin/$(Configuration)/$(TargetFramework)/ShiroBot.QQPlatform.Contracts.dll"
          DestinationFolder="$(PublishDir)" />
  </Target>
  <Import Project="$(ShiroBotSourceRoot)/SDK/buildTransitive/ShiroBot.SDK.targets" />
</Project>
